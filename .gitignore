# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev database (embedded postgres)
/.pglite-data

# sistema antigo (PHP/MySQL) — config.php tem credenciais reais do banco em
# produção no cPanel; mantido só como referência local, nunca no repositório.
/legacy-php

# imagem bruta de origem (já copiada para public/brand/ e src/app/icon.jpg,
# que são os arquivos que o app de fato usa)
/img

# typescript
*.tsbuildinfo
next-env.d.ts
